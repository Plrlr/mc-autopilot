# Which brain the bots use: mock, groq, gemini, or jev
BRAIN=mock

# Groq (free). Pick a small, fast model from Groq's current free list.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_RPM=20
GROQ_MAX_TPM=5000
GROQ_MAX_PER_DAY=900

# Gemini (free). Use a Flash or Flash-Lite model.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_RPM=5
GEMINI_MAX_PER_DAY=900

# Jev (optional). JEV_ROUTE is vercel or typesafe.
JEV_ROUTE=vercel
AI_GATEWAY_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_RUN_BUDGET_USD=0.25

# Minecraft
MC_HOST=127.0.0.1
MC_PORT=25565
BOT_COUNT=1

# Foreman: live calls Opus through claude -p; fixture reuses a saved plan (no Opus calls)
FOREMAN_MODE=fixture
FOREMAN_MAX_CALLS_PER_HOUR=20
