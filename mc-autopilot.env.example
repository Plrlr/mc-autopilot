# Copy this file to %APPDATA%\.minecraft\config\mc-autopilot.env and fill it in there.
# That file lives outside the repo, so keys can't be committed by accident.

# Tactician brain at startup: mock, opus, groq, or gemini (changeable in the in-game panel)
TACTICIAN=mock

# Opus through `claude -p` on your Claude plan (no key needed). Calls count toward plan limits.
CLAUDE_CMD=claude
OPUS_MODEL=opus
OPUS_MAX_CALLS_PER_HOUR=30
OPUS_TACTICIAN_MAX_CALLS_PER_HOUR=60
OPUS_TIMEOUT_S=60

# Groq (free). Pick a small, fast model from Groq's current free list.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MAX_RPM=20
GROQ_MAX_TPM=5000
GROQ_MAX_PER_DAY=900

# Gemini (free). Use a Flash or Flash-Lite model.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MAX_RPM=5
GEMINI_MAX_PER_DAY=900
